#!/bin/sh
#
# Runtime bootstrap, shared by every language runtime.
#
# Responsibilities, in order:
#
#   * run the `init` hook;
#   * start the language runtime named by WORKER_RUNTIME_COMMAND as a child
#     process, so this shell stays alive to handle signals;
#   * forward SIGTERM/SIGINT/SIGHUP to that child rather than dying first,
#     which is what gives the worker its chance to finish cleanly;
#   * run the `shutdown` hook and exit with the child's status.
#
# Hooks are optional executables in $WORKER_HOOK_DIR (default
# $WORKER_ROOT/hooks). They let an image add behaviour - registering the worker,
# notifying a scheduler, uploading logs - without touching worker code:
#
#   init      before the worker starts
#   sigterm   when a termination signal arrives, with the signal name
#   shutdown  after the worker exits, with its exit code
#
# Everything here is POSIX sh: the runtime images are based on slim and Alpine
# variants where /bin/sh is dash or busybox, not bash.

set -u

: "${WORKER_ROOT:=/var/task}"
: "${WORKER_RUNTIME_DIR:=/var/runtime}"
: "${WORKER_HOOK_DIR:=$WORKER_ROOT/hooks}"

pid=0

log() {
  echo "[RUNTIME] $*" >&2
}

# Run a hook if the image provides one. A hook that fails is reported but never
# changes the worker's exit code: observability must not break the job.
run_hook() {
  hook_name="$1"
  shift

  hook_path="$WORKER_HOOK_DIR/$hook_name"

  if [ -x "$hook_path" ]; then
    log "running $hook_name hook"

    if ! "$hook_path" "$@"; then
      log "$hook_name hook exited non-zero (ignored)"
    fi
  fi
}

# Forward the signal and let the runtime decide how long it needs. The runtime
# enforces its own grace period (WORKER_SHUTDOWN_TIMEOUT); duplicating that
# here would only cut short a worker that is shutting down correctly.
forward_signal() {
  signal="$1"

  log "received SIG$signal"
  run_hook sigterm "$signal"

  if [ "$pid" -ne 0 ]; then
    kill -"$signal" "$pid" 2>/dev/null || true
  fi
}

trap 'forward_signal TERM' TERM
trap 'forward_signal INT' INT
trap 'forward_signal HUP' HUP

if [ -z "${WORKER_RUNTIME_COMMAND:-}" ]; then
  log "WORKER_RUNTIME_COMMAND is not set; the image is misconfigured"
  exit 2
fi

run_hook init

log "starting worker: $WORKER_RUNTIME_COMMAND $*"

# shellcheck disable=SC2086 # WORKER_RUNTIME_COMMAND is a command line, not a path
$WORKER_RUNTIME_COMMAND "$@" &
pid=$!

# `wait` returns as soon as a trapped signal arrives, before the child has
# finished, so keep waiting until the child is genuinely gone. Without this
# loop the container would report 128+signal while the worker was still
# committing its last unit of work.
status=0
while kill -0 "$pid" 2>/dev/null; do
  wait "$pid"
  status=$?
done

run_hook shutdown "$status"

log "worker exited with status $status"

exit "$status"
