# Defaults baked into the image. Anything passed with `docker run -e` wins:
# symfony/dotenv does not override variables that are already set, and the
# runtime loads this file before booting the kernel.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change-me-in-your-secret-store

MESSENGER_TRANSPORT_DSN=amqp://guest:guest@rabbitmq:5672/%2f/messages
DATABASE_URL=postgresql://worker:worker@postgres:5432/worker?serverVersion=16
